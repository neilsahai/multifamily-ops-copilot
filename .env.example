# Operations copilot (optional). Without LLM_API_KEY the copilot runs its
# labeled deterministic fallback and the rest of the app is unaffected.
# Server-only: never prefix these with NEXT_PUBLIC_.
LLM_API_KEY=
# Defaults to claude-opus-5 when empty.
LLM_MODEL=

# Shared request budget (required for live mode on hosted deployments, where
# the app fails closed without it). Upstash for Redis REST credentials; the
# Vercel Marketplace integration sets the KV_* names automatically.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Optional caps (defaults: 60 live questions/day overall, 8/hour per visitor).
COPILOT_DAILY_LIVE_LIMIT=
COPILOT_CLIENT_HOURLY_LIMIT=
